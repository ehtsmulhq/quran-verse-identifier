{
  "name": "quran-recitation-verse-identifier",
  "version": "1.0.0",
  "description": "Chrome extension to identify Quran verses recited in browser video streams or microphone with live streaming and classical Tafsir synthesis",
  "type": "module",
  "main": "src/background/service-worker.js",
  "license": "MIT",
  "keywords": [
    "quran",
    "chrome-extension",
    "gemini",
    "gemini-live",
    "manifest-v3",
    "tafsir",
    "recitation",
    "speech-recognition"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "vitest": "^2.1.0"
  }
}
